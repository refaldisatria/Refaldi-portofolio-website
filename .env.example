# URL publik situs (dipakai untuk metadata, sitemap, robots). Isi dengan domain produksi Anda.
NEXT_PUBLIC_SITE_URL=https://domain-anda.com

# --- Pengiriman pesan form kontak (Resend: https://resend.com) ---
# Semua variabel di bawah HANYA dibaca di server. Jangan beri prefix NEXT_PUBLIC_.
RESEND_API_KEY=
# Alamat tujuan: kotak masuk Anda.
CONTACT_TO_EMAIL=
# Alamat pengirim. Harus memakai domain yang sudah diverifikasi di Resend
# (untuk uji coba: onboarding@resend.dev, hanya bisa mengirim ke email akun Resend Anda).
CONTACT_FROM_EMAIL=
